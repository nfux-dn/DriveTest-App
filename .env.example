# Copy to .env and fill in. Never commit real secrets.

# Signs the session cookie. Use a long random string in production.
DRIVETEST_SESSION_SECRET=dev-insecure-session-secret-change-me

# Fernet key used by SecretStore to encrypt Git tokens at rest.
# Generate one with:  docker compose run --rm backend python -m app.cli genkey
DRIVETEST_SECRET_ENCRYPTION_KEY=

# GitHub OAuth app credentials (optional in dev; PAT connect works without these).
DRIVETEST_GITHUB_CLIENT_ID=
DRIVETEST_GITHUB_CLIENT_SECRET=

# AI evaluator. "mock" (default) works offline with no key. Switch to "openai"
# or "anthropic" and provide the matching key to use a real provider.
DRIVETEST_AI_PROVIDER=mock
DRIVETEST_OPENAI_API_KEY=
DRIVETEST_OPENAI_MODEL=gpt-4o-mini
DRIVETEST_ANTHROPIC_API_KEY=
DRIVETEST_ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Device connections (spec section 51). "simulated" (default) needs no devices.
# Set to "ssh" to use real SSH via paramiko (requires a backend image rebuild).
DRIVETEST_SSH_TRANSPORT=simulated
DRIVETEST_SSH_DEFAULT_USERNAME=admin
